{
  "description": "A beautiful, self-contained security dashboard for Next.js apps: dependency vulnerability scanning (npm audit + OSV.dev fallback), security-header auditing, and host-app security analysis, exposed as one API route and one React component.",
  "devDependencies": {
    "@types/node": "22.7.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./security-dashboard.css": "./dist/security-dashboard.css",
    "./style.css": "./dist/security-dashboard.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "nextjs",
    "security",
    "vulnerability",
    "npm-audit",
    "osv",
    "security-headers",
    "dashboard"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "next-security-dashboard",
  "peerDependencies": {
    "next": ">=13",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/security-dashboard.css dist/security-dashboard.css",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "node ./dist/cli.js postinstall || exit 0",
    "preuninstall": "node ./dist/cli.js preuninstall || exit 0"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "0.6.2",
  "bin": {
    "next-security-dashboard": "./dist/cli.js"
  }
}
